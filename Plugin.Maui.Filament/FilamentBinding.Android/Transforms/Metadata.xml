<metadata>
  <!-- Avoid collision: android subpackage class → distinct managed name -->
  <attr path="/api/package[@name='com.google.android.filament.android']/class[@name='AndroidPlatform']"
        name="managedName">FilamentAndroidPlatform</attr>

  <!-- ToneMapper is deprecated in favour of ColorGrading -->
  <attr path="/api/package[@name='com.google.android.filament']/class[@name='ToneMapper']"
        name="obsolete">true</attr>

  <!--
    Half.CompareTo(Short): the Java Comparable<Short> implementation maps to Java.Lang.IComparable
    but the generated class only emits CompareTo(short), not CompareTo(Object). Remove the
    IComparable interface from Half to avoid the CS0535 error on the generated class.
  -->
  <remove-node path="/api/package[@name='com.google.android.filament.utils']/class[@name='Half']/implements[@name='java.lang.Comparable']" />
</metadata>
